<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ appName | default('Lliure') }}{% endblock %}</title>
    <link rel="icon" href="{{ panel.favicon }}">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- AdminLTE 4 (inclui Bootstrap 5) -->
    <link rel="stylesheet" href="{{ panel.adminlte_css | default('/vendor/almasaeed2010/adminlte/dist/css/adminlte.min.css') }}">

    <style>
        {# Cor da marca: quem hospeda define (panel.brand_color). Fica também
           como variável CSS para os apps usarem nos próprios componentes. #}
        :root {
            --lliure-brand: {{ panel.brand_color | default('#94324B') }};
            --lliure-brand-dark: {{ panel.brand_color_dark | default(panel.brand_color | default('#7a2940')) }};
        }
        .app-header.navbar-lliure {
            background-color: var(--lliure-brand) !important;
        }
        .app-header.navbar-lliure .nav-link,
        .app-header.navbar-lliure .navbar-nav .nav-link {
            color: rgba(255,255,255,.85) !important;
        }
        .app-header.navbar-lliure .nav-link:hover,
        .app-header.navbar-lliure .navbar-nav .nav-link:hover {
            color: #fff !important;
        }
        .app-header.navbar-lliure .dropdown-toggle::after {
            color: rgba(255,255,255,.85);
        }
        .navbar-brand-logo svg {
            height: {{ panel.navbar_logo_height | default('27px') }};
            width: auto;
        }
    </style>
    {% block styles %}{% endblock %}
</head>
{# O menu lateral aparece quando há itens registrados pelos apps
   (ServiceProviderInterface::registerMenu). O app pode trocar o bloco
   `sidebar` inteiro, ou desligar com panel.sidebar = false. #}
{% set hasSidebar = (panel.sidebar ?? true) and menuItems is defined and menuItems | length > 0 %}
<body class="{% block body_class %}{{ hasSidebar ? 'layout-fixed sidebar-expand-lg ' : '' }}bg-body-tertiary{% endblock %}">
    <div class="app-wrapper">

        <!-- Navbar -->
        <nav class="app-header navbar navbar-expand navbar-lliure">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    {% block navbar_left_toggle %}
                    {% if hasSidebar %}
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Recolher menu">
                            <i class="fas fa-bars"></i>
                        </a>
                    </li>
                    {% endif %}
                    {% endblock %}
                    <li class="nav-item d-none d-md-block navbar-brand-logo">
                        <a href="{{ basePath }}/" class="nav-link py-1">
                            {{ panel.navbar_logo | raw }}
                        </a>
                    </li>
                    {% block navbar_left %}{% endblock %}
                </ul>

                <!-- Right Navbar -->
                <ul class="navbar-nav ms-auto">
                    {% block navbar_right %}{% endblock %}
                    {% if currentUser %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="fas fa-user me-1"></i> {{ currentUser.name | default(currentUser.username) }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            {# Os itens do menu do usuário vêm de quem hospeda
                               (panel.user_menu: [{label, url, icon}]). Sem isso,
                               ficam os do modo sozinho. #}
                            {% if panel.user_menu is defined %}
                                {% for item in panel.user_menu %}
                                <li><a class="dropdown-item" href="{{ item.url }}"><i class="{{ item.icon | default('fas fa-circle') }} me-2"></i>{{ item.label }}</a></li>
                                {% endfor %}
                            {% else %}
                            <li><a class="dropdown-item" href="/lliure/users/{{ currentUser.id }}/edit?from={{ basePath }}"><i class="fas fa-user-edit me-2"></i>Meu Perfil</a></li>
                            <li><a class="dropdown-item" href="/lliure/users?from={{ basePath }}"><i class="fas fa-users me-2"></i>Usuários</a></li>
                            {% endif %}
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="{{ panel.logout_url | default(basePath ~ '/logout') }}"><i class="fas fa-sign-out-alt me-2"></i>Sair</a></li>
                        </ul>
                    </li>
                    {% endif %}
                </ul>
            </div>
        </nav>

        {% block sidebar %}
        {% if hasSidebar %}
        {% import _self as menu %}
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a href="{{ basePath }}/" class="brand-link">
                    <span class="brand-text fw-semibold">{{ panel.sidebar_title | default(appName) }}</span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="navigation" data-accordion="false">
                        {% for item in menuItems %}
                            {% if item.children | length > 0 %}
                            {% set grupoAtivo = false %}
                            {% for child in item.children %}
                                {% if menu.ativo(child.url, currentUri) | trim == 'active' %}{% set grupoAtivo = true %}{% endif %}
                            {% endfor %}
                            <li class="nav-item {{ grupoAtivo ? 'menu-open' : '' }}">
                                <a href="#" class="nav-link {{ grupoAtivo ? 'active' : '' }}">
                                    <i class="nav-icon {{ item.icon }}"></i>
                                    <p>{{ item.label }} <i class="nav-arrow fas fa-chevron-right"></i></p>
                                </a>
                                <ul class="nav nav-treeview">
                                    {% for child in item.children %}
                                    <li class="nav-item">
                                        <a href="{{ basePath }}{{ child.url }}" class="nav-link {{ menu.ativo(child.url, currentUri) }}">
                                            <i class="nav-icon {{ child.icon }}"></i>
                                            <p>{{ child.label }}{% if child.badge %} <span class="nav-badge badge text-bg-secondary">{{ child.badge }}</span>{% endif %}</p>
                                        </a>
                                    </li>
                                    {% endfor %}
                                </ul>
                            </li>
                            {% else %}
                            <li class="nav-item">
                                <a href="{{ basePath }}{{ item.url }}" class="nav-link {{ menu.ativo(item.url, currentUri) }}">
                                    <i class="nav-icon {{ item.icon }}"></i>
                                    <p>{{ item.label }}{% if item.badge %} <span class="nav-badge badge text-bg-secondary">{{ item.badge }}</span>{% endif %}</p>
                                </a>
                            </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </nav>
            </div>
        </aside>
        {% endif %}
        {% endblock %}

        <!-- Main Content -->
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <h3 class="mb-0">{% block content_header %}{% endblock %}</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-content">
                <div class="container-fluid">
                    {% if flash_error %}
                    <div class="alert alert-danger alert-dismissible fade show">
                        {{ flash_error }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {% endif %}

                    {% if flash_success %}
                    <div class="alert alert-success alert-dismissible fade show">
                        {{ flash_success }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {% endif %}

                    {% block content %}{% endblock %}
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="app-footer">
            <div class="float-end d-none d-sm-inline">v{{ appVersion | default('2.0.0') }}</div>
            <strong>{{ appName | default('lliure') | lower }}</strong>
        </footer>
    </div>

    <!-- Bootstrap 5 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE 4 -->
    <script src="{{ panel.adminlte_js | default('/vendor/almasaeed2010/adminlte/dist/js/adminlte.min.js') }}"></script>

    {% block scripts %}{% endblock %}
</body>
</html>

{# Item ativo: a URL do item e o comeco da URL atual ("/" so casa com "/"). #}
{% macro ativo(url, currentUri) %}{{ (url == '/' ? currentUri == '/' : (currentUri == url or currentUri starts with (url ~ '/'))) ? 'active' : '' }}{% endmacro %}
