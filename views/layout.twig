<!DOCTYPE html>
{#  panel.theme escolhe o arquivo em views/themes/; o sufixo "-dark" liga o modo
    escuro do mesmo tema (ex.: 'soft' e 'soft-dark'). 'dracula' é sempre escuro. #}
{% set tema = panel.theme ?? null %}
{% set escuro = tema == 'dracula' or (tema and tema ends with '-dark') %}
{% set arquivoTema = tema ? tema | replace({'-dark': ''}) : null %}
<html lang="pt-BR"{% if escuro %} data-bs-theme="dark"{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ appName | default('Lliure') }}{% endblock %}</title>
    <link rel="icon" href="{{ panel.favicon }}">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- AdminLTE 4 (inclui Bootstrap 5) -->
    <link rel="stylesheet" href="{{ panel.adminlte_css | default('/vendor/almasaeed2010/adminlte/dist/css/adminlte.min.css') }}">

    <style>
        {# Cor da marca: quem hospeda define (panel.brand_color). Fica também
           como variável CSS para os apps usarem nos próprios componentes. #}
        :root {
            --lliure-brand: {{ panel.brand_color | default('#94324B') }};
            --lliure-brand-dark: {{ panel.brand_color_dark | default(panel.brand_color | default('#7a2940')) }};
        }
        .app-header.navbar-lliure {
            background-color: var(--lliure-brand) !important;
        }
        .app-header.navbar-lliure .nav-link,
        .app-header.navbar-lliure .navbar-nav .nav-link {
            color: rgba(255,255,255,.85) !important;
        }
        .app-header.navbar-lliure .nav-link:hover,
        .app-header.navbar-lliure .navbar-nav .nav-link:hover {
            color: #fff !important;
        }
        .app-header.navbar-lliure .dropdown-toggle::after {
            color: rgba(255,255,255,.85);
        }
        .sidebar-brand .brand-logo-svg { color: #fff; display: inline-flex; align-items: center; }
        .sidebar-brand .brand-logo-svg svg {
            height: {{ panel.sidebar_logo_height | default('30px') }};
            width: auto;
            max-width: 100%;
        }
        /* Foto do usuário (cabeçalho e painel da conta) */
        .lliure-avatar { border-radius: 50%; object-fit: cover; flex: 0 0 auto; }
        .lliure-avatar-sm { width: 32px; height: 32px; border: 2px solid var(--bs-border-color); }
        .lliure-avatar-lg { width: 72px; height: 72px; border: 3px solid var(--lliure-brand); }
        .lliure-avatar-iniciais {
            display: inline-flex; align-items: center; justify-content: center;
            background: var(--lliure-brand); color: #fff; font-weight: 700; line-height: 1;
        }
        .lliure-avatar-sm.lliure-avatar-iniciais { font-size: .75rem; }
        .lliure-avatar-lg.lliure-avatar-iniciais { font-size: 1.6rem; }
        .lliure-user-trigger { padding-top: .25rem !important; padding-bottom: .25rem !important; display: flex; align-items: center; }

        /* Painel da conta (abre pela direita) */
        .lliure-user-panel { --bs-offcanvas-width: 300px; }
        .lliure-user-panel .offcanvas-header { justify-content: flex-end; padding: 1rem 1rem .5rem; }
        .lliure-user-panel .offcanvas-header .btn-close { font-size: .7rem; }
        .lliure-user-panel .offcanvas-body { padding: 0 1rem 1rem; }
        .lliure-user-panel .up-head { text-align: center; }
        .lliure-user-panel .up-head .lliure-avatar { margin-bottom: .75rem; }
        .lliure-user-panel .up-name { font-weight: 700; font-size: .95rem; color: var(--bs-emphasis-color); }
        .lliure-user-panel .up-email { font-size: .8rem; color: var(--bs-secondary-color); overflow-wrap: anywhere; }
        .lliure-user-panel .up-subtitle { font-size: .8rem; color: var(--bs-secondary-color); margin-top: .35rem; }
        .lliure-user-panel .up-manage {
            display: inline-block; margin-top: .85rem; padding: .35rem 1.1rem;
            border: 1px solid var(--bs-border-color); border-radius: 1rem;
            font-size: .8rem; font-weight: 600; color: var(--bs-body-color); text-decoration: none;
        }
        .lliure-user-panel .up-manage:hover { border-color: var(--lliure-brand); color: var(--bs-emphasis-color); }
        .lliure-user-panel .up-sep { border-color: var(--bs-border-color); opacity: .6; margin: 1rem .5rem; }
        .lliure-user-panel .up-nav { display: flex; flex-direction: column; gap: .35rem; }
        .lliure-user-panel .up-nav a {
            display: flex; align-items: center; gap: .65rem;
            padding: .65rem 1rem; border-radius: .75rem;
            border: 1px solid var(--bs-border-color);
            font-size: .9rem; font-weight: 500; color: var(--bs-body-color); text-decoration: none;
            transition: border-color .15s, background-color .15s;
        }
        .lliure-user-panel .up-nav a i { width: 1.1rem; text-align: center; color: var(--lliure-accent, var(--lliure-brand)); }
        .lliure-user-panel .up-nav a:hover { border-color: var(--lliure-brand); background: var(--bs-secondary-bg); color: var(--bs-emphasis-color); }
        .lliure-user-panel .up-nav .up-sair,
        .lliure-user-panel .up-nav .up-sair i { color: var(--bs-danger); }
        .lliure-user-panel .up-nav .up-sair { border-color: color-mix(in srgb, var(--bs-danger) 35%, transparent); }
        .lliure-user-panel .up-nav .up-sair:hover { border-color: var(--bs-danger); background: color-mix(in srgb, var(--bs-danger) 10%, transparent); }

        .navbar-brand-logo svg {
            height: {{ panel.navbar_logo_height | default('27px') }};
            width: auto;
        }
    </style>
    {% if arquivoTema %}{% include "themes/" ~ arquivoTema ~ ".twig" ignore missing %}{% endif %}
    {% block styles %}{% endblock %}
</head>
{# O menu lateral aparece quando há itens registrados pelos apps
   (ServiceProviderInterface::registerMenu). O app pode trocar o bloco
   `sidebar` inteiro, ou desligar com panel.sidebar = false. #}
{% set hasSidebar = (panel.sidebar ?? true) and menuItems is defined and menuItems | length > 0 %}
{% import _self as ui %}
<body class="{% block body_class %}{{ hasSidebar ? 'layout-fixed sidebar-expand-lg ' : '' }}bg-body-tertiary{% endblock %}">
    <div class="app-wrapper">

        <!-- Navbar -->
        <nav class="app-header navbar navbar-expand navbar-lliure">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    {% block navbar_left_toggle %}
                    {# Só em tela pequena, onde o menu fica escondido: no desktop
                       (sidebar-expand-lg) ele está sempre aberto, como no Soft UI. #}
                    {% if hasSidebar %}
                    <li class="nav-item d-lg-none">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Abrir menu">
                            <i class="fas fa-bars"></i>
                        </a>
                    </li>
                    {% endif %}
                    {% endblock %}
                    {# Com menu lateral, a marca fica no topo dele (sem repetir aqui). #}
                    {% if not hasSidebar %}
                    <li class="nav-item d-none d-md-block navbar-brand-logo">
                        <a href="{{ basePath }}/" class="nav-link py-1">
                            {{ panel.navbar_logo | raw }}
                        </a>
                    </li>
                    {% endif %}
                    {% block navbar_left %}{% endblock %}
                </ul>

                <!-- Right Navbar -->
                <ul class="navbar-nav ms-auto">
                    {% block navbar_right %}{% endblock %}
                    {% if currentUser %}
                    {# Só a foto; o resto da conta abre no painel lateral (#lliureUserPanel). #}
                    <li class="nav-item">
                        <a class="nav-link lliure-user-trigger" href="#" data-bs-toggle="offcanvas" data-bs-target="#lliureUserPanel" aria-controls="lliureUserPanel" title="{{ currentUser.name | default(currentUser.username) }}">
                            {{ ui.avatar(panel.user_photo ?? null, currentUser.name | default(currentUser.username), 'lliure-avatar lliure-avatar-sm') }}
                        </a>
                    </li>
                    {% endif %}
                </ul>
            </div>
        </nav>

        {% block sidebar %}
        {% if hasSidebar %}
        {% import _self as menu %}
        {# O menu é sempre escuro no AdminLTE; no tema soft ele segue a página. #}
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="{{ arquivoTema == 'soft' and not escuro ? 'light' : 'dark' }}">
            <div class="sidebar-brand">
                <a href="{{ basePath }}/" class="brand-link">
                    {% if panel.sidebar_logo is defined and panel.sidebar_logo %}<span class="brand-logo-svg">{{ panel.sidebar_logo | raw }}</span>{% else %}<span class="brand-text fw-semibold">{{ panel.sidebar_title | default(appName) }}</span>{% endif %}
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="navigation" data-accordion="false">
                        {% for item in menuItems %}
                            {% if item.children | length > 0 %}
                            {% set grupoAtivo = false %}
                            {% for child in item.children %}
                                {% if menu.ativo(child.url, currentUri) | trim == 'active' %}{% set grupoAtivo = true %}{% endif %}
                            {% endfor %}
                            <li class="nav-item {{ grupoAtivo ? 'menu-open' : '' }}">
                                <a href="#" class="nav-link {{ grupoAtivo ? 'active' : '' }}">
                                    <i class="nav-icon {{ item.icon }}"></i>
                                    <p>{{ item.label }} <i class="nav-arrow fas fa-chevron-right"></i></p>
                                </a>
                                <ul class="nav nav-treeview">
                                    {% for child in item.children %}
                                    <li class="nav-item">
                                        <a href="{{ basePath }}{{ child.url }}" class="nav-link {{ menu.ativo(child.url, currentUri) }}">
                                            <i class="nav-icon {{ child.icon }}"></i>
                                            <p>{{ child.label }}{% if child.badge %} <span class="nav-badge badge text-bg-secondary">{{ child.badge }}</span>{% endif %}</p>
                                        </a>
                                    </li>
                                    {% endfor %}
                                </ul>
                            </li>
                            {% else %}
                            <li class="nav-item">
                                <a href="{{ basePath }}{{ item.url }}" class="nav-link {{ menu.ativo(item.url, currentUri) }}">
                                    <i class="nav-icon {{ item.icon }}"></i>
                                    <p>{{ item.label }}{% if item.badge %} <span class="nav-badge badge text-bg-secondary">{{ item.badge }}</span>{% endif %}</p>
                                </a>
                            </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </nav>
            </div>
        </aside>
        {% endif %}
        {% endblock %}

        <!-- Main Content -->
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <h3 class="mb-0">{% block content_header %}{% endblock %}</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-content">
                <div class="container-fluid">
                    {% if flash_error %}
                    <div class="alert alert-danger alert-dismissible fade show">
                        {{ flash_error }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {% endif %}

                    {% if flash_success %}
                    <div class="alert alert-success alert-dismissible fade show">
                        {{ flash_success }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {% endif %}

                    {% block content %}{% endblock %}
                </div>
            </div>
        </main>

        <!-- Footer (a tela pode esvaziar o bloco, ex.: telas de tela cheia) -->
        {% block footer %}
        <footer class="app-footer">
            <div class="float-end d-none d-sm-inline">v{{ appVersion | default('2.0.0') }}</div>
            <strong>{{ appName | default('lliure') | lower }}</strong>
        </footer>
        {% endblock %}
    </div>

    {% block user_panel %}
    {% if currentUser %}
    {#  Painel da conta, que abre pela direita ao clicar na foto.
        Quem hospeda completa com:
          panel.user_photo     URL da foto (sem ela, ficam as iniciais)
          panel.user_subtitle  linha abaixo do e-mail (ex.: a instância atual)
          panel.account_url    link "Gerenciar conta"
          panel.user_menu      [{label, url, icon}]; sem isso, ficam os do modo sozinho #}
    {% set nomeUsuario = currentUser.name | default(currentUser.username) %}
    <div class="offcanvas offcanvas-end lliure-user-panel" tabindex="-1" id="lliureUserPanel" aria-label="Sua conta">
        <div class="offcanvas-header">
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
        </div>
        <div class="offcanvas-body">
            <div class="up-head">
                {{ ui.avatar(panel.user_photo ?? null, nomeUsuario, 'lliure-avatar lliure-avatar-lg') }}
                <div class="up-name">{{ nomeUsuario }}</div>
                {% if currentUser.email %}<div class="up-email">{{ currentUser.email }}</div>{% endif %}
                {% if panel.user_subtitle ?? null %}<div class="up-subtitle"><i class="fas fa-building me-1"></i>{{ panel.user_subtitle }}</div>{% endif %}
                {% if panel.account_url ?? null %}<a class="up-manage" href="{{ panel.account_url }}">Gerenciar conta</a>{% endif %}
            </div>

            <hr class="up-sep">

            <nav class="up-nav">
                {% if panel.user_menu is defined %}
                    {% for item in panel.user_menu %}
                    <a href="{{ item.url }}"><i class="{{ item.icon | default('fas fa-circle') }}"></i>{{ item.label }}</a>
                    {% endfor %}
                {% else %}
                <a href="/lliure/users/{{ currentUser.id }}/edit?from={{ basePath }}"><i class="fas fa-user-edit"></i>Meu perfil</a>
                <a href="/lliure/users?from={{ basePath }}"><i class="fas fa-users"></i>Usuários</a>
                {% endif %}

                <hr class="up-sep">

                <a href="{{ panel.logout_url | default(basePath ~ '/logout') }}" class="up-sair"><i class="fas fa-right-from-bracket"></i>Sair</a>
            </nav>
        </div>
    </div>
    {% endif %}
    {% endblock %}

    <!-- Bootstrap 5 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE 4 -->
    <script src="{{ panel.adminlte_js | default('/vendor/almasaeed2010/adminlte/dist/js/adminlte.min.js') }}"></script>

    {% block scripts %}{% endblock %}
</body>
</html>

{# Item ativo: a URL do item e o comeco da URL atual ("/" so casa com "/"). #}
{# Foto redonda; sem foto, as iniciais (primeiro e último nome) na cor da marca. #}
{% macro avatar(foto, nome, classe) %}
{%- if foto -%}
<img src="{{ foto }}" alt="" class="{{ classe }}" referrerpolicy="no-referrer">
{%- else -%}
{%- set partes = (nome | default('?')) | trim | split(' ') | filter(p => p != '') -%}
<span class="{{ classe }} lliure-avatar-iniciais" aria-hidden="true">{{ ((partes | first | first) ~ (partes | length > 1 ? partes | last | first : '')) | upper }}</span>
{%- endif -%}
{% endmacro %}

{% macro ativo(url, currentUri) %}{{ (url == '/' ? currentUri == '/' : (currentUri == url or currentUri starts with (url ~ '/'))) ? 'active' : '' }}{% endmacro %}
