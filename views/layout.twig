<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ appName | default('Lliure') }}{% endblock %}</title>
    <link rel="icon" href="{{ panel.favicon }}">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- AdminLTE 4 (inclui Bootstrap 5) -->
    <link rel="stylesheet" href="/vendor/almasaeed2010/adminlte/dist/css/adminlte.min.css">

    <style>
        .app-header.navbar-lliure {
            background-color: #94324B !important;
        }
        .app-header.navbar-lliure .nav-link,
        .app-header.navbar-lliure .navbar-nav .nav-link {
            color: rgba(255,255,255,.85) !important;
        }
        .app-header.navbar-lliure .nav-link:hover,
        .app-header.navbar-lliure .navbar-nav .nav-link:hover {
            color: #fff !important;
        }
        .app-header.navbar-lliure .dropdown-toggle::after {
            color: rgba(255,255,255,.85);
        }
        .navbar-brand-logo svg {
            height: {{ panel.navbar_logo_height | default('27px') }};
            width: auto;
        }
    </style>
    {% block styles %}{% endblock %}
</head>
<body class="{% block body_class %}bg-body-tertiary{% endblock %}">
    <div class="app-wrapper">

        <!-- Navbar -->
        <nav class="app-header navbar navbar-expand navbar-lliure">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    {% block navbar_left_toggle %}{% endblock %}
                    <li class="nav-item d-none d-md-block navbar-brand-logo">
                        <a href="{{ basePath }}/" class="nav-link py-1">
                            {{ panel.navbar_logo | raw }}
                        </a>
                    </li>
                    {% block navbar_left %}{% endblock %}
                </ul>

                <!-- Right Navbar -->
                <ul class="navbar-nav ms-auto">
                    {% block navbar_right %}{% endblock %}
                    {% if currentUser %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="fas fa-user me-1"></i> {{ currentUser.name | default(currentUser.username) }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/lliure/users/{{ currentUser.id }}/edit?from={{ basePath }}"><i class="fas fa-user-edit me-2"></i>Meu Perfil</a></li>
                            <li><a class="dropdown-item" href="/lliure/users?from={{ basePath }}"><i class="fas fa-users me-2"></i>Usuários</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="{{ basePath }}/logout"><i class="fas fa-sign-out-alt me-2"></i>Sair</a></li>
                        </ul>
                    </li>
                    {% endif %}
                </ul>
            </div>
        </nav>

        {% block sidebar %}{% endblock %}

        <!-- Main Content -->
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <h3 class="mb-0">{% block content_header %}{% endblock %}</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-content">
                <div class="container-fluid">
                    {% if flash_error %}
                    <div class="alert alert-danger alert-dismissible fade show">
                        {{ flash_error }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {% endif %}

                    {% if flash_success %}
                    <div class="alert alert-success alert-dismissible fade show">
                        {{ flash_success }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {% endif %}

                    {% block content %}{% endblock %}
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="app-footer">
            <div class="float-end d-none d-sm-inline">v{{ appVersion | default('2.0.0') }}</div>
            <strong>{{ appName | default('lliure') | lower }}</strong>
        </footer>
    </div>

    <!-- Bootstrap 5 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE 4 -->
    <script src="/vendor/almasaeed2010/adminlte/dist/js/adminlte.min.js"></script>

    {% block scripts %}{% endblock %}
</body>
</html>
