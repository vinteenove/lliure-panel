{% extends "layout.twig" %}

{% block title %}Usuários — {{ appName }}{% endblock %}

{% block content_header %}Usuários{% endblock %}

{% block content %}
    {% if origin and origin != basePath %}
    <a href="{{ origin }}" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="fas fa-arrow-left me-1"></i>Voltar para {{ origin }}
    </a>
    {% endif %}

    <div class="card">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-users me-2"></i>Lista de Usuários</h3>
            <div class="card-tools">
                <a href="{{ basePath }}/users/create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i>Novo Usuário
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            {% if users.count() > 0 %}
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Usuário</th>
                        <th>E-mail</th>
                        <th>Status</th>
                        <th style="width: 160px">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td>{{ user.name }}</td>
                        <td>{{ user.username }}</td>
                        <td>{{ user.email }}</td>
                        <td>
                            {% if user.active %}
                                <span class="badge text-bg-success">Ativo</span>
                            {% else %}
                                <span class="badge text-bg-secondary">Inativo</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ basePath }}/users/{{ user.id }}/edit" class="btn btn-sm btn-warning" title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form action="{{ basePath }}/users/{{ user.id }}/delete" method="post" class="d-inline" onsubmit="return confirm('Tem certeza que deseja excluir este usuário?')">
                                <button type="submit" class="btn btn-sm btn-danger" title="Excluir">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <div class="p-3">
                <p class="text-muted mb-0">Nenhum usuário cadastrado.</p>
            </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
