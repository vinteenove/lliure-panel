{% extends "layout.twig" %}

{% set isEdit = user is not null %}

{% block title %}{{ isEdit ? 'Editar' : 'Novo' }} Usuário — {{ appName }}{% endblock %}

{% block content_header %}{{ isEdit ? 'Editar' : 'Novo' }} Usuário{% endblock %}

{% block content %}
    {% if origin and origin != basePath %}
    <a href="{{ origin }}" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="fas fa-arrow-left me-1"></i>Voltar para {{ origin }}
    </a>
    {% endif %}

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-{{ isEdit ? 'edit' : 'user-plus' }} me-2"></i>
                {{ isEdit ? 'Editar Usuário' : 'Novo Usuário' }}
            </h3>
        </div>
        <form action="{{ basePath }}/users/{{ isEdit ? user.id ~ '/update' : 'store' }}" method="post">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="name" class="form-label">Nome <span class="text-danger">*</span></label>
                            <input type="text" id="name" name="name" class="form-control"
                                   value="{{ isEdit ? user.name : '' }}" required>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="username" class="form-label">Usuário <span class="text-danger">*</span></label>
                            <input type="text" id="username" name="username" class="form-control"
                                   value="{{ isEdit ? user.username : '' }}" required>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="email" class="form-label">E-mail <span class="text-danger">*</span></label>
                            <input type="email" id="email" name="email" class="form-control"
                                   value="{{ isEdit ? user.email : '' }}" required>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="password" class="form-label">
                                Senha
                                {% if not isEdit %}<span class="text-danger">*</span>{% endif %}
                            </label>
                            <input type="password" id="password" name="password" class="form-control"
                                   {{ not isEdit ? 'required' : '' }}>
                            {% if isEdit %}
                                <small class="form-text text-muted">Deixe em branco para manter a senha atual.</small>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input type="checkbox" id="active" name="active" class="form-check-input" value="1"
                               {{ (not isEdit or user.active) ? 'checked' : '' }}>
                        <label for="active" class="form-check-label">Ativo</label>
                    </div>
                </div>
            </div>

            <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Salvar
                </button>
                <a href="{{ basePath }}/users" class="btn btn-secondary ms-2">
                    <i class="fas fa-arrow-left me-1"></i>Cancelar
                </a>
            </div>
        </form>
    </div>
{% endblock %}
